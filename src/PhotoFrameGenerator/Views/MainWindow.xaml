<Window
    x:Class="PhotoFrameGenerator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bh="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resources="clr-namespace:PhotoFrameGenerator.Resources"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    xmlns:viewmodels="clr-namespace:PhotoFrameGenerator.ViewModels"
    Title="{Binding Title}"
    Width="1280"
    Height="800"
    d:DataContext="{d:DesignInstance Type=viewmodels:MainWindowViewModel,
                                     IsDesignTimeCreatable=True}"
    ui:WindowHelper.UseModernWindowStyle="True"
    mc:Ignorable="d">

    <Window.DataContext>
        <viewmodels:MainWindowViewModel />
    </Window.DataContext>

    <Grid>
        <DockPanel>
            <StackPanel Margin="10,10,10,10" DockPanel.Dock="Bottom">
                <TextBlock HorizontalAlignment="Right" Text="{Binding Title}" />
                <TextBlock HorizontalAlignment="Right" Text="{Binding Copyright}" />
                <TextBlock HorizontalAlignment="Right">
                    <Hyperlink Command="{Binding OpenProjectUrlCommand}" Cursor="Hand">
                        <TextBlock Text="{x:Static resources:Strings.MessageOpenProjectUrl}" />
                    </Hyperlink>
                </TextBlock>
                <StatusBar>
                    <StatusBarItem>
                        <TextBlock Text="{Binding StatusMessage}" />
                    </StatusBarItem>
                </StatusBar>
            </StackPanel>

            <StackPanel Margin="10,10,10,10">
                <TextBlock Margin="0,0,0,5" Text="{x:Static resources:Strings.AddInputFile}" />
                <Grid Margin="10,5,10,5">
                    <ListBox Height="50" AllowDrop="True">
                        <bh:Interaction.Triggers>
                            <bh:EventTrigger EventName="PreviewDragOver">
                                <bh:InvokeCommandAction Command="{Binding PreviewDragOverCommand}" PassEventArgsToCommand="True" />
                            </bh:EventTrigger>
                            <bh:EventTrigger EventName="Drop">
                                <bh:InvokeCommandAction Command="{Binding DropCommand}" PassEventArgsToCommand="True" />
                            </bh:EventTrigger>
                        </bh:Interaction.Triggers>
                    </ListBox>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        AllowDrop="True"
                        Text="{x:Static resources:Strings.MessageGuideDragAndDrop}">
                        <bh:Interaction.Triggers>
                            <bh:EventTrigger EventName="PreviewDragOver">
                                <bh:InvokeCommandAction Command="{Binding PreviewDragOverCommand}" PassEventArgsToCommand="True" />
                            </bh:EventTrigger>
                            <bh:EventTrigger EventName="Drop">
                                <bh:InvokeCommandAction Command="{Binding DropCommand}" PassEventArgsToCommand="True" />
                            </bh:EventTrigger>
                        </bh:Interaction.Triggers>
                    </TextBlock>
                </Grid>

                <TextBlock Margin="0,5,0,5" Text="{x:Static resources:Strings.InputFileList}" />
                <ListBox
                    Height="350"
                    Margin="10,5,10,5"
                    ItemsSource="{Binding InputFiles}"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                <Button
                    Width="Auto"
                    Margin="0,5,0,10"
                    HorizontalAlignment="Stretch"
                    Command="{Binding ClearCommand}"
                    Content="{x:Static resources:Strings.Clear}" />

                <TextBlock Margin="0,5,0,5" Text="{x:Static resources:Strings.EXIFInformationToDisplay}" />
                <WrapPanel Margin="10,5,10,5">
                    <CheckBox Content="{x:Static resources:Strings.CameraModel}" IsChecked="{Binding IsDisplayCameraModel}" />
                    <CheckBox Content="{x:Static resources:Strings.LensModel}" IsChecked="{Binding IsDisplayLensModel}" />
                    <CheckBox Content="{x:Static resources:Strings.FocalLength}" IsChecked="{Binding IsDisplayFocalLength}" />
                    <CheckBox Content="{x:Static resources:Strings.ExposureMode}" IsChecked="{Binding IsDisplayExposureMode}" />
                    <CheckBox Content="{x:Static resources:Strings.Aperture}" IsChecked="{Binding IsDisplayAperture}" />
                    <CheckBox Content="{x:Static resources:Strings.ShutterSpeed}" IsChecked="{Binding IsDisplayShutterSpeed}" />
                    <CheckBox Content="{x:Static resources:Strings.ExposureCompensation}" IsChecked="{Binding IsDisplayExposureCompensation}" />
                    <CheckBox Content="{x:Static resources:Strings.ISOSensitivity}" IsChecked="{Binding IsDisplayISOSensitivity}" />
                    <CheckBox Content="{x:Static resources:Strings.ShootingDateAndTime}" IsChecked="{Binding IsDisplayShootingDateAndTime}" />
                </WrapPanel>

                <Button
                    Width="Auto"
                    Margin="0,5,0,10"
                    HorizontalAlignment="Stretch"
                    Command="{Binding GenerateCommand}"
                    Content="{x:Static resources:Strings.Generate}"
                    IsEnabled="{Binding IsOperationEnable}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
